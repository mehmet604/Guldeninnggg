{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guldeninnggg-v14",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node cloudflare/assets.mjs" },
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [{ "binding": "QUOTA", "database_name": "guldeninnggg-quota" }],
  "secrets": { "required": ["OPENAI_API_KEY", "APP_PASSWORD"] }
}
